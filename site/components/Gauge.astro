---
import type { Dashboard } from "../../src/analysis/dashboard.ts";
import { fmtDate, nf0, pct } from "../lib/format.ts";
import { BACK_OFFSET, columns, outside, ripple, surfacePath } from "../scripts/water.ts";

/** The hero: a wide-mouth bottle filled to today's level, with this date's highest, typical and lowest. */
interface Props {
  d: Dashboard;
}
const { d } = Astro.props;
const level = d.latest.totalPct;
const { typicalPct, recordLow, recordHigh } = d.health.seasonal;
const when = fmtDate(d.latest.date, false);
const aria = `Whole system ${pct(level)} full on ${fmtDate(d.latest.date)}. Typical for ${when}: ${pct(typicalPct)}${recordLow && recordHigh ? `; lowest ${pct(recordLow.pct)} (${recordLow.year}), highest ${pct(recordHigh.pct)} (${recordHigh.year})` : ""}.`;

// The bottle's inside. Straight walls between `top` (100%) and `bottom` (0%), so the water's
// height is the share full; the shoulder above `top` only catches sloshes.
const L = 18;
const R = 222;
const top = 138;
const bottom = 450;
const mid = (L + R) / 2;
const WALL = R + 12; // outside of the plastic, where the side scale starts
const yOf = (v: number) => bottom - ((bottom - top) * v) / 100;
const y = yOf(level);

const outer = `M60,86 C30,90 6,104 6,128 V422 Q6,462 46,462 H194 Q234,462 234,422 V128 C234,104 210,90 180,86 Z`;
const inner = `M72,98 C42,102 ${L},114 ${L},${top} V422 Q${L},${bottom} 46,${bottom} H194 Q${R},${bottom} ${R},422 V${top} C${R},114 198,102 168,98 Z`;

// The still frame (no JavaScript, reduced motion, and the first paint); site/scripts/water.ts animates it.
const floor = bottom + 30;
const xs = columns(L, R);
const front = surfacePath(
  xs,
  xs.map((x) => y - ripple(x, 0)),
  floor,
);
const back = surfacePath(
  xs,
  xs.map((x) => y - BACK_OFFSET - ripple(x, 0, true)),
  floor,
);

const ty = typicalPct === null ? null : yOf(typicalPct);
// The number and its caption take about 100 units; keep them off the waterline.
const clear = (t: number) => (y < t - 68 || y > t + 52) && t - 58 > top && t + 42 < bottom - 6;
const textY = [300, y + 70, y - 52].find(clear) ?? 300;

// Side scale for this date: highest, typical and lowest since records began.
const marks: { v: number; text: string; cls: string }[] = [];
if (recordHigh) marks.push({ v: recordHigh.pct, text: `highest ${nf0.format(recordHigh.pct)}%`, cls: "rec" });
if (typicalPct !== null) marks.push({ v: typicalPct, text: `typical ${nf0.format(typicalPct)}%`, cls: "typ" });
if (recordLow) marks.push({ v: recordLow.pct, text: `lowest ${nf0.format(recordLow.pct)}%`, cls: "rec" });
marks.sort((a, b) => b.v - a.v);
let lastY = Number.NEGATIVE_INFINITY;
const placed = marks.map((mk) => {
  const my = yOf(mk.v);
  const ly = Math.max(my, lastY + 22);
  lastY = ly;
  return { ...mk, my, ly };
});
const head = placed[0];
---

<svg
  viewBox="0 0 392 468"
  role="img"
  aria-label={aria}
  data-water
  data-left={L}
  data-right={R}
  data-level={y}
  data-floor={floor}
>
  <defs>
    <clipPath id="inside"><path d={inner}></path></clipPath>
    <clipPath id="below-water"><path d={front.closed} data-surface="below"></path></clipPath>
    <clipPath id="above-water"><path d={outside(front.closed)} clip-rule="evenodd" data-surface="above"></path></clipPath>
    <linearGradient id="water-fill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="stop-top"></stop>
      <stop offset="1" class="stop-bottom"></stop>
    </linearGradient>
    {/* Shade at both walls makes the bottle read as round, not a flat panel. */}
    <linearGradient id="glass">
      <stop offset="0" stop-color="#000" stop-opacity="0.1"></stop>
      <stop offset="0.16" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="0.8" stop-color="#000" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#000" stop-opacity="0.1"></stop>
    </linearGradient>
  </defs>
  <path d="M94,28 C94,4 146,4 146,28" class="loop"></path>
  <rect x="56" y="66" width="128" height="26" rx="4" class="neck"></rect>
  <rect x="48" y="22" width="144" height="50" rx="10" class="cap"></rect>
  {Array.from({ length: 11 }, (_, i) => <line x1={65 + i * 11} x2={65 + i * 11} y1="31" y2="63" class="ridge" />)}
  <path d={outer} class="bottle"></path>
  <path d={inner} class="inside"></path>
  <g clip-path="url(#inside)">
    <path d={back.closed} class="wave-back" data-surface="back"></path>
    <path d={front.closed} class="wave-front" data-surface="front"></path>
    <path d={front.open} class="wave-crest" data-surface="crest"></path>
  </g>
  {
    /* Drawn twice: ink above the waterline, white below it. */
    [
      ["", "above-water"],
      ["on-water", "below-water"],
    ].map(([cls, clip]) => (
      <g clip-path={`url(#${clip})`} class={cls}>
        {[25, 50, 75].map((v) => (
          <line x1={L + 8} x2={L + (v === 50 ? 28 : 20)} y1={yOf(v)} y2={yOf(v)} class="grad" />
        ))}
        {ty !== null && <line x1={L + 36} x2={R - 8} y1={ty} y2={ty} class="typical" />}
        <text x={mid} y={textY} text-anchor="middle" class="big">
          {nf0.format(level)}<tspan class="unit" dx="2">%</tspan>
        </text>
        <text x={mid} y={textY + 36} text-anchor="middle" class="under">full, as of {when}</text>
      </g>
    ))
  }
  <path d={inner} class="glass"></path>
  <rect x={R - 26} y={top + 10} width="7" height={bottom - top - 70} rx="3.5" class="shine"></rect>
  <g class="scale">
    {
      head && (
        <text x={WALL + 22} y={yOf(head.v) - 24} dy="0.34em" class="mark when">
          on {when}:
        </text>
      )
    }
    {
      placed.map((mk) => (
        <>
          <path
            d={`M${WALL - 12},${mk.my} L${WALL + 6},${mk.my} L${WALL + 14},${mk.ly} L${WALL + 18},${mk.ly}`}
            class={`lead ${mk.cls}`}
          />
          <text x={WALL + 22} y={mk.ly} dy="0.34em" class={`mark ${mk.cls}`}>
            {mk.text}
          </text>
        </>
      ))
    }
  </g>
</svg>
