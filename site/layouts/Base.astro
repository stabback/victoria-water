---
import { AUTHOR, AUTHOR_EMAIL, AUTHOR_GITHUB, AUTHOR_LINKEDIN, REPO_URL, SITE_URL } from "../../src/config.ts";
import { dashboard } from "../lib/data.ts";
import { fmtDate, fmtStamp } from "../lib/format.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Site-relative path of this page, e.g. "/" or "/sources/". */
  path: string;
  /** What site/scripts/app.ts draws from: inlined as JSON, only the parts this page needs. */
  payload: unknown;
}
const { title, description, path, payload } = Astro.props;
const d = dashboard();
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <link rel="canonical" href={`${SITE_URL}${path}`} />
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <meta name="theme-color" content="#0e7c86" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1618" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Victoria Water" />
    <meta property="og:url" content={`${SITE_URL}${path}`} />
    <meta property="og:image" content={`${SITE_URL}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body>
    <div class="sky" aria-hidden="true"></div>
    <header class="top">
      <a class="brand" href="/" aria-label="Victoria Water home">
        <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
          <defs>
            <linearGradient id="drop" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#4fc3c9" />
              <stop offset="1" stop-color="#0e7c86" />
            </linearGradient>
          </defs>
          <path d="M16 2.5C16 2.5 6 13.6 6 20a10 10 0 0 0 20 0C26 13.6 16 2.5 16 2.5Z" fill="url(#drop)" />
          <path d="M9.6 20.6c2.1-1.3 4.3-1.3 6.4 0s4.3 1.3 6.4 0" stroke="#fff" stroke-width="1.6" fill="none" stroke-linecap="round" opacity=".9" />
        </svg>
      </a>
      <a class="fresh-badge" href="/sources/#freshness">
        <span class="fresh-long">Water data from</span><span class="fresh-short">Data</span> <time datetime={d.latest.date} data-relative>{fmtDate(d.latest.date)}</time>
      </a>
      <nav aria-label="Pages">
        <a href="/sources/" aria-current={path === "/sources/" ? "page" : undefined}>Sources</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="foot-col">
        <p class="foot-head">Victoria Water</p>
        <p class="foot-by">
          Built by {AUTHOR}
          <a class="foot-icon" href={AUTHOR_GITHUB} rel="me noopener" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              />
            </svg>
          </a>
          <a class="foot-icon" href={AUTHOR_LINKEDIN} rel="me noopener" aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
              />
            </svg>
          </a>
        </p>
        <p><a href={`mailto:${AUTHOR_EMAIL}`}>{AUTHOR_EMAIL}</a></p>
        <p><a href={REPO_URL} rel="noopener">Source code</a> · MIT licence</p>
        <p>Not affiliated with the CRD</p>
        <p>Page built {fmtStamp(d.generatedAt)}</p>
      </div>
      <div class="foot-col">
        <p class="foot-head">Data</p>
        <p>Capital Regional District · Environment and Climate Change Canada · Open-Meteo</p>
        <p><a href="/sources/">Sources and downloads →</a></p>
      </div>
    </footer>

    <script type="application/json" id="dashboard" is:inline set:html={JSON.stringify(payload).replace(/</g, "\\u003c")} />
    <script>
      import "../scripts/app.ts";
    </script>
  </body>
</html>
