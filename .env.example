# Nothing here is secret. All settings are optional.
PORT=3000
# Address to listen on; 0.0.0.0 for all interfaces (the Dockerfile sets it).
HOST=127.0.0.1
# Public URL, baked into the build: canonical links, sitemap and Open Graph tags.
SITE_URL=http://localhost:3000
# Where the SQLite database lives.
DATA_DIR=./data
# Alertmanager-style webhook to notify when a new report is in and the site is rebuilt.
ALERT_URL=
