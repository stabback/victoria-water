{
  "name": "victoria-water",
  "version": "0.1.0",
  "description": "Greater Victoria (BC) reservoir levels, weather and water use — current and historical.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "update": "bun src/update.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "ingest": "bun src/ingest/cli.ts",
    "lint": "astro check && tsc --noEmit",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "bun test"
  },
  "dependencies": {
    "@elysia/static": "^1.4.12",
    "astro": "^7.4.7",
    "elysia": "^1.4.31",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@biomejs/biome": "^2.6.6",
    "@types/bun": "^1.4.4",
    "typescript": "~5.9.3"
  }
}
